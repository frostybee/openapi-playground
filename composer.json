        {
            "name": "Frostybee",
            "homepage": "https://github.com/frostybee",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"echo 'Project ready. Point your web server document root at the public/ directory.\\n';\""
        ]
